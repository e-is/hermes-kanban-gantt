# kanban-gantt demo/test environment — copy to .env and adapt (never committed).
#
# Used by: tests/demo-server.mjs, tests/demo_playwright.mjs
# Explicit environment variables always win over .env values.

# Python interpreter that can run the standalone backend
# (dashboard/plugin_api.py needs fastapi + uvicorn + pydantic + pyyaml).
# In the Hermes team container this is /opt/hermes/.venv/bin/python.
KG_PYTHON=/opt/hermes/.venv/bin/python

# Optional checkout of hermes-agent containing hermes_cli/ — prepended to
# PYTHONPATH for the seed script and the standalone backend. Not needed when
# KG_PYTHON is a venv where hermes_cli is already importable.
KG_AGENT_HOME=

# Playwright's JS module — npm -g install location varies by machine:
#   container / CI : /usr/local/lib/node_modules/playwright/index.mjs
#   nvm install    : ~/.nvm/versions/node/<v>/lib/node_modules/playwright/index.mjs
# Left empty = the script falls back to `import 'playwright'` (needs to be
# resolvable from the repo) then the container path.
KG_PLAYWRIGHT_MODULE=

# Playwright browsers download dir (chromium binaries).
# Default: ~/.cache/ms-playwright (Linux); override in containers
# (e.g. /opt/data/tmp/pw-browsers).
PLAYWRIGHT_BROWSERS_PATH=

# Optional: pin a specific browser build instead of auto-detection.
KG_CHROMIUM_PATH=